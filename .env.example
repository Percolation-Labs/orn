# Copy to .env (git-ignored) and fill in.

# HuggingFace — needed for pulling SmolLM2 tokenizer, baseline models, and pushing checkpoints.
HF_TOKEN=
HF_HOME=~/.cache/huggingface

# Weights & Biases — optional; leave blank to disable.
WANDB_API_KEY=

# Default output + data locations (can be overridden per-run).
ORN_OUTPUT_DIR=output
ORN_DATA_DIR=data
