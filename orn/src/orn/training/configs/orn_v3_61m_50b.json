{
    "_description": "ORN-V3-61M (6x wide shared FFN). Half GPT-2's params, matched FFN budget. 50B tokens.",
    "model": {
        "arch": "orn_v3",
        "d_model": 576,
        "n_layers": 24,
        "n_q_heads": 9,
        "n_kv_heads": 3,
        "d_head": 64,
        "d_corr": 64,
        "vocab_size": 50304,
        "seq_len": 2048,
        "ffn_width_mult": 6
    },
    "tokenizer": { "name": "tiktoken-gpt2" },
    "data":      { "dataset": "fineweb-edu", "path": "data/" },
    "loss":      { "type": "lm_ce" },
    "training": {
        "lr": 3e-4,
        "weight_decay": 0.1,
        "betas": [0.9, 0.95],
        "grad_clip": 1.0,
        "warmup_steps": 2000,
        "max_tokens": 50000000000,
        "batch_size": 2,
        "seq_len": 2048,
        "grad_accum_steps": 32,
        "log_every_steps": 100,
        "eval_every_steps": 500,
        "generate_every_steps": 5000,
        "checkpoint_every_tokens": 5000000000,
        "compile": true,
        "mixed_precision": true
    }
}
